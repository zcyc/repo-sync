[Unit]
Description=repo-sync task scheduler and webhook listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=repo-sync
Group=repo-sync
WorkingDirectory=/var/lib/repo-sync
ExecStart=/usr/local/bin/repo-sync --database /var/lib/repo-sync/repo-sync.sqlite3 --serve 127.0.0.1:8080
EnvironmentFile=/etc/repo-sync/webhook.env
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=/var/lib/repo-sync
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
